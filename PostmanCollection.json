{
  "info": {
    "name": "RocketFood API",
    "_postman_id": "rocketfood-api-collection",
    "description": "RocketFood Delivery API — All endpoints. Set baseUrl variable before running. Login auto-saves the JWT token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",           "value": "http://localhost:8080", "type": "string" },
    { "key": "token",             "value": "",  "type": "string" },
    { "key": "user_id",           "value": "1",  "type": "string" },
    { "key": "customer_id",       "value": "2",  "type": "string" },
    { "key": "courier_id",        "value": "1",  "type": "string" },
    { "key": "employee_id",       "value": "1",  "type": "string" },
    { "key": "restaurant_id",     "value": "1",  "type": "string" },
    { "key": "product_id",        "value": "1",  "type": "string" },
    { "key": "order_id",          "value": "1",  "type": "string" },
    { "key": "address_id",        "value": "1",  "type": "string" },
    { "key": "courier_status_id", "value": "1",  "type": "string" },
    { "key": "order_status_id",   "value": "1",  "type": "string" },
    { "key": "product_order_id",  "value": "1",  "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set('token', json.accessToken);",
                  "}",
                  "if (json.customer_id) {",
                  "  pm.collectionVariables.set('customer_id', String(json.customer_id));",
                  "}",
                  "if (json.user_id) {",
                  "  pm.collectionVariables.set('user_id', String(json.user_id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@gmail.com\",\n  \"password\": \"password\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] }
          }
        }
      ]
    },

    {
      "name": "Users",
      "item": [
        {
